# 1. Inteligência Artificial Google Gemini
GEMINI_API_KEY=

# 2. Números Autorizados WhatsApp (DDI + DDD + Número)
AUTHORIZED_PHONE=5511999999999

# 3. Google Calendar & Sincronização Segura
GOOGLE_CALENDAR_ID=primary
# Política de Sincronização Real (Fail-Closed: bloqueada por padrão em homologação e desenvolvimento)
# Para autorizar chamadas de rede externas da API Google Calendar em produção:
# GOOGLE_SYNC_LIVE_ENABLED=true
# Whitelist estrita de e-mails de contas Google autorizadas a sincronizar (separados por vírgula):
# GOOGLE_SYNC_ALLOWED_EMAILS=contato@salao.com.br,atendimento@salao.com.br

# 4. Configuração Operacional & Segurança
PORT=3333
BASE_URL=https://raiaagentes.com.br
PAUSE_PERSONAL_ASSISTANT=true
ADMIN_PASSWORD=
ADMIN_PIN=
ADMIN_API_KEY=

# 5. Hotmart Webhook & Assinaturas
HOTMART_PRODUCT_ID=8840376
HOTMART_WEBHOOK_SECRET=
HOTMART_PLAN_START_ID=
HOTMART_PLAN_PRO_ID=
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC_TOKEN=

# 6. Conta Demonstrativa de Homologação Hotmart
DEMO_ACCOUNT_EMAIL=homologacao.hotmart@raiaagentes.com.br
DEMO_ACCOUNT_PASSWORD=

# 7. Asaas (Assinaturas e Vendas Diretas RAIA)
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_SECRET=

# 8. Marketing & Analytics (Opcional)
