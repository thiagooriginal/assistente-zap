# Chave de API do Google Gemini (gratuita em https://aistudio.google.com/)
GEMINI_API_KEY=

# Seu número de WhatsApp com DDI e DDD (exemplo: 5511999999999)
# Se deixar em branco, qualquer mensagem enviada para o bot será respondida
AUTHORIZED_PHONE=

# ID da Agenda do Google Calendar (o padrão 'primary' é a sua agenda principal)
GOOGLE_CALENDAR_ID=primary
